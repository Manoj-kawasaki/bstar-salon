# ============================================================
# B★STAR Unisex Salon — Environment Variables Example
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), add these in the Project Settings -> Environment Variables.
# NEVER commit .env or .env.local containing real secret keys to source control.
# ============================================================

# OpenRouter AI Configuration (Server-Side Only - Nemotron Free Endpoint)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Daily Review Request Safety Budget (Free usage limit: 20 per day)
DAILY_REVIEW_LIMIT=20

# WhatsApp Integration (Optional / Server-Side Only)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
SALON_OWNER_PHONES=
CLOUDZAP_API_URL=
